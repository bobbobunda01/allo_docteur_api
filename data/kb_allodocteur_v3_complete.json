{
  "kb_version": "4.0-clean",
  "name": "KB AlloDocteur V4 Clean",
  "description": "Base de connaissances de triage syndromique nettoyée, avec garde-fous anti-faux-positifs, règles hiérarchisées et required_fields pour usage e-santé contrôlé.",
  "governance": {
    "clinical_scope": "triage_orientation_only",
    "not_a_diagnosis": true,
    "safety_first": true,
    "review_required_for_production": true,
    "rule_policy": {
      "hard_red_flags_override_score": true,
      "global_syndromes_allowed": true,
      "required_fields_mandatory_for_syndrome_validation": true,
      "diagnostic_reference_never_directly_matchable": true
    },
    "score_policy": {
      "score_to_priority": [
        { "min": 0, "max": 1, "priority": "P4" },
        { "min": 2, "max": 3, "priority": "P3" },
        { "min": 4, "max": 100, "priority": "P2" }
      ],
      "dominance_rule": "Tout red flag critique valide force P1 et arrête l'évaluation."
    }
  },
  "priority_levels": [
    { "code": "P1", "label": "Urgence vitale", "action": "emergency_referral" },
    { "code": "P2", "label": "Urgence", "action": "urgent_medical_review" },
    { "code": "P3", "label": "Consultation rapide", "action": "rapid_consultation" },
    { "code": "P4", "label": "Consultation standard / conseils", "action": "standard_consultation_or_selfcare" }
  ],
  "messages": {
